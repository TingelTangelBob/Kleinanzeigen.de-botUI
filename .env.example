# Vorlage ohne Geheimnisse. Kopieren nach .env und ausfuellen.
# .env selbst ist von .gitignore ausgeschlossen.

# Schluessel fuer die Verschluesselung der Zugangsdaten (AP-1.4).
# Erzeugen mit:  openssl rand -base64 32
# Ohne diesen Wert startet das Backend, kann aber keine Zugangsdaten speichern.
ANZEIGEN_STUDIO_SECRET_KEY=

# Entwicklungsmodus: ausfuehrlichere Fehlermeldungen.
ANZEIGEN_STUDIO_DEV=false
