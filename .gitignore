# Local work folder that is not checked in
_LOCAL/

.*
!.act-event.json
!.actrc
!.gitattribute
!.gitignore
!.github/
!.markdownlint-cli2.jsonc

# kleinanzeigen_bot
/config.yaml
/data
/*.log
/src/kleinanzeigen_bot/_version.py
downloaded-ads

# python
__pycache__
/dist

# IntelliJ
/*.iml
/*.ipr
/*.iws

# Vim
*.swo
*.swp

# --- Anzeigen-Studio-Fork-Ergänzung, 2026-08-22, additiv, nichts Obiges verändert ---
# Zusätzliche Ausschlüsse für die neuen Verzeichnisse src/anzeigen_studio/ und webui/
# sowie für Laufzeitdaten des Fork-Backends. Siehe NOTICE.md.

# Vorlagen ohne Geheimnisse bleiben trotz ".*"-Regel oben sichtbar
!.env.*.example

# Laufzeit- und Bestandsdaten (Profile, Zugangsdaten, Anzeigen, Nachrichten)
/data/
*.db
*.db-wal
*.db-shm

# Python (Backend)
.venv/
.pdm-python
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Frontend (webui/)
webui/node_modules/
webui/dist/
webui/*.tsbuildinfo

.DS_Store
