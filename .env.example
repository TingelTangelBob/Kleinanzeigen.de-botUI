# Vorlage ohne Geheimnisse. Kopieren nach .env und ausfuellen.
# .env selbst ist von .gitignore ausgeschlossen.

# Schluessel fuer die Verschluesselung der Zugangsdaten (AP-1.4).
# Erzeugen mit:  openssl rand -base64 32
# Ohne diesen Wert startet das Backend, kann aber keine Zugangsdaten speichern.
ANZEIGEN_STUDIO_SECRET_KEY=

# Variante der Installation:
# false = Open Source: jeder Betreiber hinterlegt seinen eigenen KI-Schluessel
# true  = gehostet: der Schluessel bleibt beim Betreiber und wird nicht in der
#         Oberflaeche angeboten.
ANZEIGEN_STUDIO_GEHOSTET=false
# Nur fuer die gehostete Variante. Niemals committen.
ANZEIGEN_STUDIO_OPENAI_API_KEY=
# Hoechstens vier Bilder pro KI-Entwurf; weniger spart Verbrauch.
ANZEIGEN_STUDIO_KI_MAX_BILDER=4
# Vorgabe fuer das KI-Modell. In der Open-Source-Variante laesst es sich unter
# Einstellungen aus einer geprueften Liste waehlen; gehostet gilt immer dieser Wert.
ANZEIGEN_STUDIO_KI_MODELL=gpt-6-luna
# Wie viele Fotoanalysen gleichzeitig laufen (1-8). Mehr beschleunigt Stapel.
ANZEIGEN_STUDIO_KI_PARALLEL=4

# Entwicklungsmodus: ausfuehrlichere Fehlermeldungen.
ANZEIGEN_STUDIO_DEV=false

# eBay Sandbox OAuth (AP-E-03). Keine echten Secrets committen.
# App ID / Cert ID aus dem Developer Portal (Sandbox-Keyset).
# RuName = Redirect-URL-Name, der auf /api/ebay/oauth/callback zeigt.
# EBAY_SANDBOX_APP_ID=
# EBAY_SANDBOX_CERT_ID=
# EBAY_SANDBOX_RUNAME=
